{
    "version": 2,
    "buildCommand": "npm run build",
    "outputDirectory": ".",
    "redirects": [
        {
            "source": "/skills/index.html",
            "destination": "/skills",
            "permanent": true
        },
        {
            "source": "/projects/index.html",
            "destination": "/projects",
            "permanent": true
        },
        {
            "source": "/achievements/index.html",
            "destination": "/achievements",
            "permanent": true
        },
        {
            "source": "/contact/index.html",
            "destination": "/contact",
            "permanent": true
        }
    ],
    "headers": [
        {
            "source": "/(.*)\\.(js|css|webp|svg|ico|woff2|pdf)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        },
        {
            "source": "/(.*)\\.(html|json)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=0, must-revalidate"
                }
            ]
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "/$1"
        }
    ]
}