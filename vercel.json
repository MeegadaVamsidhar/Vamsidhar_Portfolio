{
    "version": 2,
    "buildCommand": "npm run build",
    "outputDirectory": ".",
    "redirects": [
        {
            "source": "/skills/index.html",
            "destination": "/skills",
            "permanent": true
        },
        {
            "source": "/projects/index.html",
            "destination": "/projects",
            "permanent": true
        },
        {
            "source": "/achievements/index.html",
            "destination": "/achievements",
            "permanent": true
        },
        {
            "source": "/contact/index.html",
            "destination": "/contact",
            "permanent": true
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "/$1"
        }
    ]
}